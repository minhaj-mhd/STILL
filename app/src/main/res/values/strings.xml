    <!-- Precision mode -->
    <string name="precision_service_label">STILL Precision mode</string>
    <string name="precision_service_description">Lets STILL notice which app is in front, so your blocks, schedules, launch delays and time reminders apply however you open an app, and lets you lock the screen by double-tapping home and open your notifications by swiping down on it. STILL can\'t read what\'s on screen or what you type, and nothing leaves your phone.</string>
    <string name="precision_title">Precision mode</string>
    <string name="precision_intro">Without it, STILL only steps in when you open apps from STILL. Apps opened from Recents, a notification or a link get past your blocks.</string>
    <string name="precision_what_it_does">What it does</string>
    <string name="precision_does_everywhere">• Blocks, schedules, launch delays and time reminders apply however you open an app.</string>
    <string name="precision_does_time_up">• When time\'s up, STILL steps in front of the app instead of only sending a notification.</string>
    <string name="precision_does_lock">• Double-tap empty space on home to lock the screen, and swipe down to open your notifications.</string>
    <string name="precision_what_it_sees">What STILL sees</string>
    <string name="precision_sees">Precision mode uses Android\'s Accessibility service only to notice which app is in front. STILL can\'t read what\'s on screen, what you type or your passwords. Nothing is saved, and nothing leaves your phone.</string>
    <string name="precision_agree">Agree and turn on</string>
    <string name="precision_steps">In the Accessibility settings that open next, choose STILL Precision mode and turn it on.</string>
    <string name="precision_restricted">If Android says the setting is restricted: open App info, tap ⋮ at the top right, choose Allow restricted settings, then try again.</string>
    <string name="precision_app_info">Open App info</string>
    <string name="precision_on">Precision mode is on.</string>
    <string name="precision_stuck">Android shows Precision mode as on, but it isn\'t running. This can happen after STILL updates. In Accessibility settings, turn STILL Precision mode off, then on again.</string>
    <string name="precision_turn_off">Turn off</string>
    <string name="precision_lost_title">Precision mode is off, so blocks only work when you open apps from STILL.</string>
    <string name="precision_lost_turn_on">Turn on</string>
    <string name="precision_lost_dismiss">Dismiss</string>
