    <string name="settings_double_tap_lock_needs_precision">Double-tap empty space on home. Needs Precision mode.</string>
    <string name="lock_needs_precision_title">Locking needs Precision mode</string>
    <string name="lock_needs_precision_body">Turn on Precision mode to lock the screen with a double-tap. You can turn this gesture off in Settings.</string>
