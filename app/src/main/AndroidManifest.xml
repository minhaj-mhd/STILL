<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Opens the system uninstall dialog from the long-press menu. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Required to send AlarmClock.ACTION_SHOW_ALARMS when the clock is tapped. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- Reminders: show notifications, ring at the exact minute, and survive a reboot. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Screen time per app. Special access: the user turns it on under Settings > Usage access. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- See every launchable app without the restricted QUERY_ALL_PACKAGES permission, and the
         other home apps, whose Recents focus mode leaves alone. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:name=".StillApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Still"
        tools:targetApi="33">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:resumeWhilePausing="true"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Reminder alarms and notification buttons; only STILL's own pending intents reach it. -->
        <receiver
            android:name=".reminders.ReminderReceiver"
            android:exported="false" />

        <!-- In-app time reminders: "1 minute left" and "time's up". -->
        <receiver
            android:name=".reminders.AppTimeReminderReceiver"
            android:exported="false" />

        <!--
            Precision mode: notices which app is in front so blocks apply however it was opened,
            and locks the screen on a double-tap. Only Android can bind it, and only after the
            user turns it on in Accessibility settings.
        -->
        <service
            android:name=".precision.PrecisionService"
            android:exported="true"
            android:label="@string/precision_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/precision_service" />
        </service>

        <!--
            Notification filter: sees notifications as they're posted and holds back those from
            apps the user hasn't allowed. Only Android can bind it, once Notification access is on.
        -->
        <service
            android:name=".notifications.NotificationFilterService"
            android:exported="true"
            android:label="@string/held_service_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- The daily phone limit's check alarm. -->
        <receiver
            android:name=".limit.LimitCheckReceiver"
            android:exported="false" />

        <!-- The focus timer's end alarm and its notification's Stop button. -->
        <receiver
            android:name=".focus.FocusTimerReceiver"
            android:exported="false" />

        <!-- Re-arms the next reminder after events that clear or shift alarms. -->
        <receiver
            android:name=".reminders.SystemEventReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
