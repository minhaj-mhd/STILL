<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Opens the system uninstall dialog from the long-press menu. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Required to send AlarmClock.ACTION_SHOW_ALARMS when the clock is tapped. -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- Reminders: show notifications, ring at the exact minute, and survive a reboot. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Daily reads: STILL fetches reads from the person's own Google Drive, read-only. Nothing else goes online. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Screen time per app. Special access: the user turns it on under Settings > Usage access. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- See every launchable app without the restricted QUERY_ALL_PACKAGES permission, and the
         other home apps, whose Recents focus mode leaves alone. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:name=".StillApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Still"
        tools:targetApi="33">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:resumeWhilePausing="true"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- "Import as plan" in the Share menu: shared text, e.g. an AI chat's reply, opens in
             STILL's plan editor to look over and create. It saves nothing itself. -->
        <activity
            android:name=".ShareListActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:label="@string/share_label"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- STILL Read's reader, opened from the Read tab only. -->
        <activity
            android:name=".ReaderActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:theme="@style/Theme.Still.Reader" />

        <!-- STILL Read's daily reads: the series from ChatGPT's scheduled chats, and connecting Drive. -->
        <activity
            android:name=".DailyReadsActivity"
            android:exported="false"
            android:theme="@style/Theme.Still.Page" />

        <!-- "Add to STILL Read" in the Share menu: a PDF or EPUB is copied into STILL's library. -->
        <activity
            android:name=".ShareBookActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:label="@string/share_book_label"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="application/epub+zip" />
            </intent-filter>
        </activity>

        <!-- A daily reads series is due: look in its Drive folder. -->
        <receiver
            android:name=".read.DailyReadsAlarm"
            android:exported="false" />

        <!-- Reminder alarms and notification buttons; only STILL's own pending intents reach it. -->
        <receiver
            android:name=".reminders.ReminderReceiver"
            android:exported="false" />

        <!-- In-app time reminders: "1 minute left" and "time's up". -->
        <receiver
            android:name=".reminders.AppTimeReminderReceiver"
            android:exported="false" />

        <!--
            Precision mode: notices which app is in front so blocks apply however it was opened,
            and locks the screen on a double-tap. Only Android can bind it, and only after the
            user turns it on in Accessibility settings.
        -->
        <service
            android:name=".precision.PrecisionService"
            android:exported="true"
            android:label="@string/precision_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/precision_service" />
        </service>

        <!--
            Short videos: leaves YouTube Shorts and Instagram Reels when they fill the screen. Apart
            from Precision mode, as it reads those two apps' views; Android shows it no other app.
            Only Android can bind it, and only after the user turns it on in Accessibility settings.
        -->
        <service
            android:name=".shortvideo.ShortVideoService"
            android:exported="true"
            android:label="@string/short_video_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/short_video_service" />
        </service>

        <!--
            Notification filter: sees notifications as they're posted and holds back those from
            apps the user hasn't allowed. Only Android can bind it, once Notification access is on.
        -->
        <service
            android:name=".notifications.NotificationFilterService"
            android:exported="true"
            android:label="@string/held_service_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- The daily phone limit's check alarm. -->
        <receiver
            android:name=".limit.LimitCheckReceiver"
            android:exported="false" />

        <!-- The focus timer's end alarm and its notification's Stop button. -->
        <receiver
            android:name=".focus.FocusTimerReceiver"
            android:exported="false" />

        <!-- Re-arms the next reminder after events that clear or shift alarms. -->
        <receiver
            android:name=".reminders.SystemEventReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
